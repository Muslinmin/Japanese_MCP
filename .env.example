# Copy to .env for local runs. .env is gitignored; never commit a real token.

# --- storage: set exactly one ---
# Deployed: the GCS bucket holding the notes.
VAULT_BUCKET=bunpro-vault-example
# Local: a folder of .md files. Ignored when VAULT_BUCKET is set.
# VAULT_PATH=/home/you/Obsidian/Japanese

# --- auth ---
# The shared secret clients send as "Authorization: Bearer <token>".
# Generate with: openssl rand -base64 32
# In Cloud Run this comes from Secret Manager via --set-secrets, never
# --set-env-vars (env vars show up in the console and in deploy logs).
MCP_AUTH_TOKEN=replace-me

# --- runtime ---
# Cloud Run injects PORT; this is only for local runs.
PORT=8080
# Sets the day boundary for the review schedule. Should be the learner's
# timezone, not the server's.
TZ=Asia/Singapore
