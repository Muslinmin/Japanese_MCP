# Copy to .env for local runs. .env is gitignored; never commit a real token.

# --- storage: set exactly one ---
# Deployed: the GCS bucket holding the notes.
VAULT_BUCKET=bunpro-vault-example
# Local: a folder of .md files. Ignored when VAULT_BUCKET is set.
# VAULT_PATH=/home/you/Obsidian/Japanese

# --- auth ---
# One secret, three jobs: the password on the OAuth login page, the key
# every issued token is signed with, and a bearer token accepted directly
# by clients that can set a header (Claude Code, Claude Desktop).
# Rotating it invalidates every token already issued — by design, but it
# means reconnecting the connector afterwards.
# Generate with: openssl rand -base64 32
# In Cloud Run this comes from Secret Manager via --set-secrets, never
# --set-env-vars (env vars show up in the console and in deploy logs).
MCP_AUTH_TOKEN=replace-me

# The externally reachable base URL. OAuth discovery advertises it as the
# issuer and resource identifier, and clients compare it against what they
# dialled — a mismatch fails the connection with no useful error.
# Chicken-and-egg on Cloud Run: the URL doesn't exist until the first
# deploy, so deploy.sh deploys once, reads it back, and sets it.
# Defaults to http://localhost:$PORT, which is right for local runs.
# MCP_PUBLIC_URL=https://bunpro-mcp-xxxxxxxxxx-as.a.run.app

# --- runtime ---
# Cloud Run injects PORT; this is only for local runs.
PORT=8080
# Sets the day boundary for the review schedule. Should be the learner's
# timezone, not the server's.
TZ=Asia/Singapore
